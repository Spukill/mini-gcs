// Pins the .NET SDK version used to build this repo. Without it, `dotnet` picks the
// newest SDK installed on the machine, so my PC and the CI server could build with
// different versions. "latestFeature" still allows newer 10.0.x patch/feature releases
// (bug and security fixes) but never jumps to another major version like 11.
{
  "sdk": {
    "version": "10.0.404",
    "rollForward": "latestFeature"
  }
}
