<!--
  The solution: a list of all the projects that belong to this app, so a single
  `dotnet build` or `dotnet test` at the root handles all of them together.
  Each project (.csproj) produces exactly one output (an .exe or a .dll library),
  and a real app is usually split into several: MiniGcs.App (the WPF window) and
  MiniGcs.Sniffer (a console tool that prints incoming MAVLink packets).
  Building the solution builds them all; running is still one program at a time.
  Same idea as a parent pom.xml with <modules> in Maven, or a top-level Makefile in C.
-->
<Solution>
  <Folder Name="/src/">
    <Project Path="src/MiniGcs.App/MiniGcs.App.csproj" />
    <Project Path="src/MiniGcs.Mavlink/MiniGcs.Mavlink.csproj" />
    <Project Path="src/MiniGcs.Sniffer/MiniGcs.Sniffer.csproj" />
  </Folder>
</Solution>
