<!--
  The main window's layout: XAML describes WHAT the window looks like (like HTML or
  JSX), while MainWindow.xaml.cs holds its code. x:Class links this file to the C#
  class MiniGcs.App.MainWindow. Grid is a layout container (rows/columns, like a CSS
  grid); inside it a StackPanel stacks its children vertically (like flex-direction:
  column). Each TextBlock binds to one property of MainViewModel; StringFormat works
  like printf in C ({0:F1} = %.1f, {0:F6} = %.6f, {0:F0} = no decimals).
-->
<Window x:Class="MiniGcs.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="mini-gcs" Height="450" Width="800">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Telemetry" FontSize="24" FontWeight="Bold" Margin="0,0,0,15" />

            <TextBlock Text="{Binding ArmedText, StringFormat=Status: {0}}" FontSize="18" />
            <TextBlock Text="{Binding FlightMode, StringFormat=Mode: {0}}" FontSize="18" />
            <TextBlock Text="{Binding Latitude, StringFormat=Latitude: {0:F6}°}" FontSize="18" />
            <TextBlock Text="{Binding Longitude, StringFormat=Longitude: {0:F6}°}" FontSize="18" />
            <TextBlock Text="{Binding Altitude, StringFormat=Altitude: {0:F1} m}" FontSize="18" />
            <TextBlock Text="{Binding GroundSpeed, StringFormat=Ground speed: {0:F1} m/s}" FontSize="18" />
            <TextBlock Text="{Binding BatteryPercent, StringFormat=Battery: {0:F0} %}" FontSize="18" />
        </StackPanel>
    </Grid>
</Window>
