<!--
  Class library (.dll) holding the MAVLink C# code generated by mavgen from ArduPilot's
  official message definitions (see README.md here). I treat it as a black box: the
  files in Generated/ are never edited by hand, because regenerating would overwrite
  any change. Anything that needs adjusting is done in this file instead:
  - AllowUnsafeBlocks: the generated code uses `unsafe` (raw memory, like pointers in C)
    to convert bytes into message structs quickly.
  - Nullable/ImplicitUsings off: the generated code was written without these features.
  - NoWarn SYSLIB0021: an obsolete crypto class used only for packet signing, which we
    don't use.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>$(NoWarn);SYSLIB0021</NoWarn>
  </PropertyGroup>

</Project>
