<!--
  The main window's layout: XAML describes WHAT the window looks like (like HTML or
  JSX), while MainWindow.xaml.cs holds its code. x:Class links this file to the C#
  class MiniGcs.App.MainWindow. Grid is a layout container (rows/columns, like a CSS
  grid); for now it only holds one centered TextBlock (a piece of text). This is the
  screen where the telemetry will be shown in phase 1.
-->
<Window x:Class="MiniGcs.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="mini-gcs" Height="450" Width="800">
    <Grid>
        <TextBlock Text="mini-gcs — Ground Control Station (fase 0)"
                   FontSize="20"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
    </Grid>
</Window>
